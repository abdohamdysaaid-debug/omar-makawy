{
  "name": "omar-makawy-frontend-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start:web",
    "start:web": "npm run start --workspace=@omar-makawy/web",
    "start:admin": "npm run start --workspace=@omar-makawy/staff",
    "start:supervisor": "npm run start --workspace=@omar-makawy/supervisor",
    "start:staff": "npm run start --workspace=@omar-makawy/staff",
    "dev:web": "npm run dev --workspace=@omar-makawy/web",
    "dev:admin": "npm run dev --workspace=@omar-makawy/admin",
    "dev:supervisor": "npm run dev --workspace=@omar-makawy/supervisor",
    "dev:staff": "npm run dev --workspace=@omar-makawy/staff",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@omar-makawy/web",
    "build:admin": "npm run build --workspace=@omar-makawy/staff",
    "build:supervisor": "npm run build --workspace=@omar-makawy/supervisor",
    "build:staff": "npm run build --workspace=@omar-makawy/staff",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4",
    "swiper": "^11.1.14"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.4.5"
  }
}
